{
    "name": "circuit-high-contrast",
    "displayName": "Circuit High Contrast",
    "description": "Dark and light high-contrast color themes built on the Circuit design system palette",
    "version": "0.6.1",
    "publisher": "danish-circuit",
    "repository": {
        "type": "git",
        "url": "https://github.com/danish-circuit/circuit-high-contrast"
    },
    "homepage": "https://github.com/danish-circuit/circuit-high-contrast",
    "engines": {
        "vscode": "^1.28.0"
    },
    "keywords": [
        "theme",
        "dark",
        "high-contrast",
        "color-theme"
    ],
    "categories": [
        "Themes"
    ],
    "galleryBanner": {
        "color": "#000000",
        "theme": "dark"
    },
    "icon": "icon.png",
    "contributes": {
        "themes": [
            {
                "label": "Circuit High Contrast Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/circuit-high-contrast-dark.json"
            },
            {
                "label": "Circuit High Contrast Light",
                "uiTheme": "vs",
                "path": "./themes/circuit-high-contrast-light.json"
            }
        ]
    },
    "devDependencies": {
        "prettier": "^2.3.0",
        "@vscode/vsce": "^3.1.0"
    }
}

{
    "$schema": "vscode://schemas/color-theme",
    "name": "Circuit High Contrast Dark",
    "tokenColors": [
        {
            "settings": {
                "foreground": "#FFFFFF",
                "background": "#000000",
                "caret": "#FFFFFF",
                "invisibles": "#3d3d3d",
                "lineHighlight": "#1d2520",
                "selection": "#11572e",
                "findHighlight": "#ffe29e",
                "findHighlightForeground": "#FFFFFF",
                "selectionBorder": "#183826",
                "activeGuide": "#a66b0cB0",
                "bracketsForeground": "#edededA5",
                "bracketsOptions": "underline",
                "bracketContentsForeground": "#edededA5",
                "bracketContentsOptions": "underline",
                "tagsOptions": "stippled_underline"
            }
        },
        {
            "name": "Comment",
            "scope": ["comment"],
            "settings": { "foreground": "#7d7d7d" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#fbb81b" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#d398ff" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#d398ff" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#d398ff" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "fontStyle": "bold", "foreground": "#eb605c" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "bold", "foreground": "#eb605c" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#7ce2fe" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#1ce370" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#1ce370"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#1ce370" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#ffa057" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "bold", "foreground": "#eb605c" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#1ce370" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#7ce2fe" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#7ce2fe" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic", "foreground": "#7ce2fe" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#e1292f",
                "fontStyle": "bold",
                "foreground": "#FFFFFF"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#a953f5", "foreground": "#FFFFFF" }
        },
        {
            "name": "JSON String",
            "scope": [
                "meta.structure.dictionary.json",
                "string.quoted.double.json"
            ],
            "settings": { "foreground": "#ededed" }
        },
        {
            "name": "diff.header",
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#a1a1a1" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#eb605c" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#1ce370" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#fbb81b" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#d398ffA0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#fbb81b" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "foreground": "#1ce370" }
        },
        {
            "scope": "heading.1.markdown",
            "settings": { "foreground": "#1ce370", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.heading.markdown",
            "settings": { "foreground": "#1ce370" }
        },
        {
            "scope": "entity.name.section.markdown",
            "settings": { "foreground": "#1ce370" }
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#d398ff" }
        },
        {
            "scope": "meta.image.inline.markdown",
            "settings": { "foreground": "#fbb81b" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic.markdown",
            "settings": { "foreground": "#FFFFFF", "fontStyle": "italic" }
        },
        {
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "foreground": "#7ce2fe" }
        },
        {
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#7d7d7d" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#d398ff" }
        },
        {
            "scope": [
                "variable.other.object",
                "punctuation.accessor",
                "meta.brace.round",
                "variable.other.readwrite",
                "punctuation.separator.comma"
            ],
            "settings": { "foreground": "#FFFFFF" }
        }
    ],
    "colors": {
        "foreground": "#FFFFFF",
        "icon.foreground": "#FFFFFF",
        "contrastBorder": "#1ce37075",
        "contrastActiveBorder": "#00000000",
        "focusBorder": "#1ce37075",

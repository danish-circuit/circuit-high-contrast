{
    "$schema": "vscode://schemas/color-theme",
    "name": "Circuit High Contrast Light",
    "tokenColors": [
        {
            "settings": {
                "foreground": "#171717",
                "background": "#FFFFFF",
                "caret": "#171717",
                "invisibles": "#dbdbdb",
                "lineHighlight": "#effaf4",
                "selection": "#adebc7",
                "findHighlight": "#fbe579",
                "findHighlightForeground": "#171717",
                "selectionBorder": "#adebc7",
                "activeGuide": "#fece5cB0",
                "bracketsForeground": "#171717A5",
                "bracketsOptions": "underline",
                "bracketContentsForeground": "#171717A5",
                "bracketContentsOptions": "underline",
                "tagsOptions": "stippled_underline"
            }
        },
        {
            "name": "Comment",
            "scope": ["comment"],
            "settings": { "foreground": "#707070" }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": { "foreground": "#a35c00" }
        },
        {
            "name": "Number",
            "scope": "constant.numeric",
            "settings": { "foreground": "#711fb7" }
        },
        {
            "name": "Built-in constant",
            "scope": "constant.language",
            "settings": { "foreground": "#711fb7" }
        },
        {
            "name": "User-defined constant",
            "scope": ["constant.character", "constant.other"],
            "settings": { "foreground": "#711fb7" }
        },
        {
            "name": "Variable",
            "scope": "variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Keyword",
            "scope": "keyword",
            "settings": { "fontStyle": "bold", "foreground": "#a60d11" }
        },
        {
            "name": "Storage",
            "scope": "storage",
            "settings": { "fontStyle": "bold", "foreground": "#a60d11" }
        },
        {
            "name": "Storage type",
            "scope": "storage.type",
            "settings": { "fontStyle": "italic", "foreground": "#00749e" }
        },
        {
            "name": "Class name",
            "scope": "entity.name.class",
            "settings": { "fontStyle": "underline", "foreground": "#0f763a" }
        },
        {
            "name": "Inherited class",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic underline",
                "foreground": "#0f763a"
            }
        },
        {
            "name": "Function name",
            "scope": "entity.name.function",
            "settings": { "fontStyle": "", "foreground": "#0f763a" }
        },
        {
            "name": "Function argument",
            "scope": "variable.parameter",
            "settings": { "fontStyle": "italic", "foreground": "#cc4e00" }
        },
        {
            "name": "Tag name",
            "scope": "entity.name.tag",
            "settings": { "fontStyle": "bold", "foreground": "#a60d11" }
        },
        {
            "name": "Tag attribute",
            "scope": "entity.other.attribute-name",
            "settings": { "fontStyle": "", "foreground": "#0f763a" }
        },
        {
            "name": "Library function",
            "scope": "support.function",
            "settings": { "fontStyle": "", "foreground": "#00749e" }
        },
        {
            "name": "Library constant",
            "scope": "support.constant",
            "settings": { "fontStyle": "", "foreground": "#00749e" }
        },
        {
            "name": "Library class/type",
            "scope": ["support.type", "support.class"],
            "settings": { "fontStyle": "italic", "foreground": "#00749e" }
        },
        {
            "name": "Library variable",
            "scope": "support.other.variable",
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "background": "#e1292f",
                "fontStyle": "bold",
                "foreground": "#FFFFFF"
            }
        },
        {
            "name": "Invalid deprecated",
            "scope": "invalid.deprecated",
            "settings": { "background": "#a953f5", "foreground": "#FFFFFF" }
        },
        {
            "name": "JSON String",
            "scope": [
                "meta.structure.dictionary.json",
                "string.quoted.double.json"
            ],
            "settings": { "foreground": "#171717" }
        },
        {
            "name": "diff.header",
            "scope": "meta.diff, meta.diff.header",
            "settings": { "foreground": "#707070" }
        },
        {
            "name": "diff.deleted",
            "scope": "markup.deleted",
            "settings": { "foreground": "#c72a2e" }
        },
        {
            "name": "diff.inserted",
            "scope": "markup.inserted",
            "settings": { "foreground": "#0f763a" }
        },
        {
            "name": "diff.changed",
            "scope": "markup.changed",
            "settings": { "foreground": "#a35c00" }
        },
        {
            "scope": "constant.numeric.line-number.find-in-files - match",
            "settings": { "foreground": "#711fb7A0" }
        },
        {
            "scope": "entity.name.filename.find-in-files",
            "settings": { "foreground": "#a35c00" }
        },
        {
            "name": "Language methods",
            "scope": ["variable.language"],
            "settings": { "foreground": "#0f763a" }
        },
        {
            "scope": "heading.1.markdown",
            "settings": { "foreground": "#0f763a", "fontStyle": "bold" }
        },
        {
            "scope": "punctuation.definition.heading.markdown",
            "settings": { "foreground": "#0f763a" }
        },
        {
            "scope": "entity.name.section.markdown",
            "settings": { "foreground": "#0f763a" }
        },
        {
            "scope": "punctuation.definition.list.begin.markdown",
            "settings": { "foreground": "#711fb7" }
        },
        {
            "scope": "meta.image.inline.markdown",
            "settings": { "foreground": "#a35c00" }
        },
        {
            "scope": "markup.bold.markdown",
            "settings": { "foreground": "#171717", "fontStyle": "bold" }
        },
        {
            "scope": "markup.italic.markdown",
            "settings": { "foreground": "#171717", "fontStyle": "italic" }
        },
        {
            "scope": "markup.inline.raw.string.markdown",
            "settings": { "foreground": "#00749e" }
        },
        {
            "scope": "meta.separator.markdown",
            "settings": { "foreground": "#858585" }
        },
        {
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end"
            ],
            "settings": { "foreground": "#711fb7" }
        },
        {
            "scope": [
                "variable.other.object",
                "punctuation.accessor",
                "meta.brace.round",
                "variable.other.readwrite",
                "punctuation.separator.comma"
            ],
            "settings": { "foreground": "#171717" }
        }
    ],
    "colors": {
        "foreground": "#171717",
        "icon.foreground": "#171717",
        "contrastBorder": "#18c15f75",
        "contrastActiveBorder": "#FFFFFF00",
        "focusBorder": "#18c15f75",
